<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LifeManagementApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LifeManagementApp"
    xmlns:views="clr-namespace:LifeManagementApp.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="LifeManagementApp">

    <TabBar>
        <ShellContent Title="Home"
                      ContentTemplate="{DataTemplate local:MainPage}"
                      Route="MainPage" />
        <ShellContent Title="To-do"
                      ContentTemplate="{DataTemplate views:TodoListPage}"
                      Route="TodoListPage" />
    </TabBar>
</Shell>