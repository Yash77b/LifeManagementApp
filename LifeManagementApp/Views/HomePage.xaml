<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             xmlns:models="clr-namespace:LifeManagementApp.Models"
             x:Class="LifeManagementApp.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <!-- Top 3 to-dos -->
            <Label Text="Top 3 to-dos" FontSize="22" FontAttributes="Bold" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopTodos}" Spacing="6">
                <BindableLayout.EmptyView>
                    <Label Text="Nothing to do 🎉" />
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TodoItem">
                        <Border Padding="12">
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Priority, StringFormat='Priority: {0}'}" />
                                <Label Text="{Binding DueDate, StringFormat='Due: {0:dd.MM.yyyy}'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Weather -->
            <Label Text="Weather in Vaasa" FontSize="22" FontAttributes="Bold" Margin="0,16,0,0" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
            <Label Text="{Binding WeatherText}" FontSize="18" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <!-- Kitesurf alert -->
            <Border IsVisible="{Binding IsKiteWeather}" BackgroundColor="Orange" Padding="12">
                <Label Text="🪁 Kitesurf weather!" FontSize="20" FontAttributes="Bold" TextColor="Black" />
            </Border>

            <Button Text="Refresh weather" Command="{Binding LoadWeatherCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>