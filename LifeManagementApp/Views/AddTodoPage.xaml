<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             x:Class="LifeManagementApp.Views.AddTodoPage"
             x:DataType="vm:AddTodoViewModel"
             Title="Add to-do">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Title" />
        <Entry Text="{Binding Title}" Placeholder="What do you need to do?" />

        <Label Text="Priority (1 = low, 5 = high)" />
        <Picker ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />

        <Label Text="Due date" />
        <DatePicker Date="{Binding DueDate}" Format="dd.MM.yyyy" />

        <Button Text="Save" Command="{Binding SaveCommand}" />

    </VerticalStackLayout>
</ContentPage>