<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LifeManagementApp.ViewModels"
             x:Class="LifeManagementApp.Views.EditTodoPage"
             x:DataType="vm:EditTodoViewModel"
             Title="Edit to-do">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="Title" />
        <Entry Text="{Binding Title}" />

        <Label Text="Priority (1 = low, 5 = high)" />
        <Picker ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />

        <Label Text="Due date" />
        <DatePicker Date="{Binding DueDate}" Format="dd.MM.yyyy" />

        <HorizontalStackLayout Spacing="8">
            <CheckBox IsChecked="{Binding IsDone}" />
            <Label Text="Done" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <Button Text="Save" Command="{Binding SaveCommand}" />

    </VerticalStackLayout>
</ContentPage>